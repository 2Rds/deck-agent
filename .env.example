# Brand / domain
BRAND_DOMAIN=deckredteam.com
PUBLIC_BASE_URL=http://localhost:3000

# Database (Supabase Postgres via the transaction pooler — port 6543, IPv4-compatible).
# Direct connection on port 5432 is IPv6-only and breaks on most serverless and WSL environments.
# Get this from Supabase dashboard → Settings → Database → Connection string → "Transaction" pooler.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:6543/postgres

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_INTRO=price_...
STRIPE_PRICE_ID_STANDARD=price_...
INTRO_PRICE_CENTS=2900
STANDARD_PRICE_CENTS=4900
INTRO_PRICING_END_DATE=2026-06-01T00:00:00Z

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Resend
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=report@deckredteam.com

# Cloudflare R2 (S3-compatible)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=deckredteam-decks
R2_ACCOUNT_ID=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Sentry (server-side error monitoring — REQUIRED in production)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=2rds-innovative-solutions-llc
SENTRY_PROJECT=javascript-nextjs

# Sentry client-side error monitoring (intentionally commented out for local dev to
# avoid polluting the production Sentry project with HMR errors and dev-mode noise.
# Uncomment in production env only — Vercel will set this for production deploys.)
# NEXT_PUBLIC_SENTRY_DSN=
